{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhaleJu",
  "version": "0.0.1",
  "identifier": "com.whale.mangju.studio",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "鲸鲨漫剧 · 本地工作台",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/engine/whaleju-engine/**/*"
    ]
  }
}